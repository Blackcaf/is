        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Concurrent update of the same object">
          <stringProp name="HTTPSampler.path">${context}/api/vehicles/${__P(target1Id)}</stringProp>
