      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Verify transaction isolation expectations" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
def failures = []
def get = { key -&gt; (props.get(key) ?: &apos;0&apos;) as int }

if (get(&apos;dup201&apos;) != 1 || get(&apos;dup409&apos;) != 1 || get(&apos;dupOther&apos;) != 0) {
    failures &lt;&lt; &quot;Уникальность названия: ожидалось ровно по одному 201 и 409, получено 201=${get(&apos;dup201&apos;)}, 409=${get(&apos;dup409&apos;)}, other=${get(&apos;dupOther&apos;)}&quot;
}
if (get(&apos;upd200&apos;) != 1 || get(&apos;upd409&apos;) != 1 || get(&apos;updOther&apos;) != 0) {
    failures &lt;&lt; &quot;Конкурентное обновление: ожидалось ровно по одному 200 и 409, получено 200=${get(&apos;upd200&apos;)}, 409=${get(&apos;upd409&apos;)}, other=${get(&apos;updOther&apos;)}&quot;
}

def raceUpdateOk = get(&apos;raceUpd200&apos;)
def raceDeleteOk = get(&apos;raceDel200&apos;)
def raceOther = get(&apos;raceUpd404&apos;) + get(&apos;raceUpd409&apos;) + get(&apos;raceDel404&apos;) + get(&apos;raceDel409&apos;)
def raceTotal = raceUpdateOk + raceDeleteOk + raceOther
if (raceTotal != 2) {
    failures &lt;&lt; &quot;Гонка update/delete: ожидалось 2 операции, получено ${raceTotal}&quot;
}
if ((raceUpdateOk + raceDeleteOk) != 1) {
    failures &lt;&lt; &quot;Гонка update/delete: ровно одна операция должна завершиться успешно, получено update200=${raceUpdateOk}, delete200=${raceDeleteOk}&quot;
}

if (props.get(&apos;validImportCode&apos;) != &apos;201&apos;) {
    failures &lt;&lt; &quot;Импорт корректного файла: ожидался 201, получен ${props.get(&apos;validImportCode&apos;)}&quot;
}
if (get(&apos;validImportCount&apos;) != 3) {
    failures &lt;&lt; &quot;Импорт корректного файла: ожидалось 3 добавленных объекта, получено ${get(&apos;validImportCount&apos;)}&quot;
}
if (props.get(&apos;failedImportCode&apos;) != &apos;400&apos;) {
    failures &lt;&lt; &quot;Импорт некорректного файла: ожидался 400, получен ${props.get(&apos;failedImportCode&apos;)}&quot;
}
if (get(&apos;atomicTotal&apos;) != 0) {
    failures &lt;&lt; &quot;Атомарность импорта: после ошибочного импорта найдено ${get(&apos;atomicTotal&apos;)} объектов ATOMIC-*&quot;
}
if (props.get(&apos;userHistoryOk&apos;) != &apos;true&apos;) {
    failures &lt;&lt; &quot;История импорта: пользователь не видит свою успешную операцию&quot;
}
if (props.get(&apos;adminHistoryOk&apos;) != &apos;true&apos;) {
    failures &lt;&lt; &quot;История импорта: администратор не видит операцию обычного пользователя&quot;
}

def summary = &quot;&quot;&quot;Итоги JMeter:
  create same unique name: 201=${get(&apos;dup201&apos;)}, 409=${get(&apos;dup409&apos;)}, other=${get(&apos;dupOther&apos;)}
  concurrent update:       200=${get(&apos;upd200&apos;)}, 409=${get(&apos;upd409&apos;)}, other=${get(&apos;updOther&apos;)}
  update/delete race:      update200=${raceUpdateOk}, delete200=${raceDeleteOk}, other=${raceOther}
  import:                  validCode=${props.get(&apos;validImportCode&apos;)}, added=${get(&apos;validImportCount&apos;)}, invalidCode=${props.get(&apos;failedImportCode&apos;)}, atomicTotal=${get(&apos;atomicTotal&apos;)}
  history:                 userOwn=${props.get(&apos;userHistoryOk&apos;)}, adminAll=${props.get(&apos;adminHistoryOk&apos;)}
&quot;&quot;&quot;
log.info(summary)
if (!failures.isEmpty()) {
    throw new AssertionError(failures.join(&apos;\n&apos;))
}
</stringProp>
        </JSR223Sampler>
