      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="99 Final verification" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Verify transaction isolation expectations" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
def failures = []
def get = { key -> (props.get(key) ?: '0') as int }

if (get('dup201') != 1 || get('dup409') != 1 || get('dupOther') != 0) {
    failures << "Уникальность названия: ожидалось ровно по одному 201 и 409, получено 201=${get('dup201')}, 409=${get('dup409')}, other=${get('dupOther')}"
}
if (get('upd200') != 1 || get('upd409') != 1 || get('updOther') != 0) {
    failures << "Конкурентное обновление: ожидалось ровно по одному 200 и 409, получено 200=${get('upd200')}, 409=${get('upd409')}, other=${get('updOther')}"
}

def raceUpdateOk = get('raceUpd200')
def raceDeleteOk = get('raceDel200')
def raceOther = get('raceUpd404') + get('raceUpd409') + get('raceDel404') + get('raceDel409')
def raceTotal = raceUpdateOk + raceDeleteOk + raceOther
if (raceTotal != 2) {
    failures << "Гонка update/delete: ожидалось 2 операции, получено ${raceTotal}"
}
if ((raceUpdateOk + raceDeleteOk) != 1) {
    failures << "Гонка update/delete: ровно одна операция должна завершиться успешно, получено update200=${raceUpdateOk}, delete200=${raceDeleteOk}"
}

if (props.get('validImportCode') != '201') {
    failures << "Импорт корректного файла: ожидался 201, получен ${props.get('validImportCode')}"
}
if (get('validImportCount') != 3) {
    failures << "Импорт корректного файла: ожидалось 3 добавленных объекта, получено ${get('validImportCount')}"
}
if (props.get('failedImportCode') != '400') {
    failures << "Импорт некорректного файла: ожидался 400, получен ${props.get('failedImportCode')}"
}
if (get('atomicTotal') != 0) {
    failures << "Атомарность импорта: после ошибочного импорта найдено ${get('atomicTotal')} объектов ATOMIC-*"
}
if (props.get('userHistoryOk') != 'true') {
    failures << "История импорта: пользователь не видит свою успешную операцию"
}
if (props.get('adminHistoryOk') != 'true') {
    failures << "История импорта: администратор не видит операцию обычного пользователя"
}

def summary = """Итоги JMeter:
  create same unique name: 201=${get('dup201')}, 409=${get('dup409')}, other=${get('dupOther')}
  concurrent update:       200=${get('upd200')}, 409=${get('upd409')}, other=${get('updOther')}
  update/delete race:      update200=${raceUpdateOk}, delete200=${raceDeleteOk}, other=${raceOther}
  import:                  validCode=${props.get('validImportCode')}, added=${get('validImportCount')}, invalidCode=${props.get('failedImportCode')}, atomicTotal=${get('atomicTotal')}
  history:                 userOwn=${props.get('userHistoryOk')}, adminAll=${props.get('adminHistoryOk')}
"""
log.info(summary)
if (!failures.isEmpty()) {
    throw new AssertionError(failures.join('\n'))
}
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
