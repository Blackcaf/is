          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Exactly one 201 and one 409" enabled="false">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49587">201</stringProp>
              <stringProp name="51517">409</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Ожидался 201 (создан) или 409 (нарушена уникальность)</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">33</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Record duplicate create result" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
 def code = prev.getResponseCode()
 if (code == &apos;201&apos; || code == &apos;409&apos;) prev.setSuccessful(true)
def key = (code == &apos;201&apos; || code == &apos;409&apos;) ? (&apos;dup&apos; + code) : &apos;dupOther&apos;
synchronized (props) {
    props.put(key, String.valueOf(((props.get(key) ?: &apos;0&apos;) as int) + 1))
}
</stringProp>
          </JSR223PostProcessor>
